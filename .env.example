# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable (anon) key. Safe for the browser: access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: the service-role key is intentionally NOT used anywhere in this app.

# Playwright e2e (runs against the real project: use the owner account)
E2E_USERNAME=
E2E_PASSWORD=
